{
  "manifest_version": 3,
  "name": "Dealbots — AI Deal of the Day",
  "version": "1.0.7",
  "description": "AI-picked Amazon deal of the day — one real daily deal, filtered from genuine shopper communities, not fake sales.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["https://xeonproc.github.io/*"]
}
