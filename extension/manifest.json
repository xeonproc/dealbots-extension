{
  "manifest_version": 3,
  "name": "Dealbots — AI Deal of the Day",
  "version": "1.0.5",
  "description": "One AI-picked deal a day, sourced from real shopper community posts and filtered for genuine, actionable pricing.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["https://xeonproc.github.io/*"]
}
