# Copy this file to .env and fill in real values once you're ready to go live.
# Leave USE_MOCK_DATA=true (or unset) to test the pipeline against the
# fixtures in pipeline/fixtures/ with no API keys at all.

USE_MOCK_DATA=true

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed if ANTHROPIC_API_KEY is an org-level key, not a workspace-scoped
# one (you'll see a "not scoped to a workspace" error without it). Prefer
# creating a workspace-scoped key in the Console instead — leave this blank.
ANTHROPIC_WORKSPACE_ID=

KEEPA_API_KEY=

AFFILIATE_TAG=dealbots00-20

# Tuning knobs (optional, sensible defaults in src/config.js)
TRENDING_RANK_IMPROVEMENT_PCT=0.3
MIN_DISCOUNT_PCT=20
MAX_DEALS_PER_DAY=1
