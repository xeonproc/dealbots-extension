# Copy this file to .env and fill in real values once you're ready to go live.
#
# DATA_SOURCE=slickdeals (default): fully automated — reads Slickdeals'
#   public RSS feed, Claude picks the best Amazon-linked deal, extracts
#   price info from the free-text post, and writes the blurb.
# DATA_SOURCE=manual: reads pipeline/candidates.json, which you fill in by
#   hand each day.
# DATA_SOURCE=mock: reads pipeline/fixtures/*.json fake data, for testing
#   the pipeline itself (not real deals).
# DATA_SOURCE=live: calls Keepa (not implemented yet, needs a paid plan or
#   PA-API eligibility).
DATA_SOURCE=slickdeals

ANTHROPIC_API_KEY=
# Leave unset to use the default in src/config.js (currently claude-haiku-4-5).
# Uncomment to override — but an empty/commented line is NOT the same as
# leaving the var out entirely; a var set here always overrides the code
# default even if you later change config.js, which has bitten us once
# already. Prefer changing the default in config.js over setting this.
# ANTHROPIC_MODEL=claude-haiku-4-5
# Only needed if ANTHROPIC_API_KEY is an org-level key, not a workspace-scoped
# one (you'll see a "not scoped to a workspace" error without it). Prefer
# creating a workspace-scoped key in the Console instead — leave this blank.
ANTHROPIC_WORKSPACE_ID=

KEEPA_API_KEY=

AFFILIATE_TAG=dealbots00-20

# Tuning knobs (optional, sensible defaults in src/config.js — same override
# caveat as ANTHROPIC_MODEL above applies to MAX_DEALS_PER_DAY)
TRENDING_RANK_IMPROVEMENT_PCT=0.3
MIN_DISCOUNT_PCT=20
# MAX_DEALS_PER_DAY=8

# Daily social posting (both optional — leave blank to skip that channel).
# See README "Traffic strategy" for how to get these values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
